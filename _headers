# Cloudflare Pages headers.
#
# The game used to be one HTML file, and this file still said so long after it
# was split into css/ and js/. Only the HTML had a cache rule, so browsers kept
# serving stale stylesheets and scripts after a deploy: new markup, old layout,
# and a site that looked unchanged no matter what was uploaded.
#
# Two defences now. These headers stop assets being held indefinitely, and the
# asset URLs in index.html carry a ?v= build tag so an already-cached copy
# cannot be reused at all. Bump the tag in index.html on every release.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheet and scripts. Versioned in the HTML, so a long cache would be safe,
# but revalidating costs one conditional request and removes a whole class of
# "why has nothing changed" problem.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Puzzle responses carry today's clues and must never sit in a shared cache.
# The Functions set this themselves too; this is belt and braces.
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
